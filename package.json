{
  "name": "sandstone-internal-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply sandstone-internal-portal --local",
    "db:migrate:remote": "wrangler d1 migrations apply sandstone-internal-portal --remote",
    "db:seed:local": "wrangler d1 execute sandstone-internal-portal --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute sandstone-internal-portal --remote --file=./seed/seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.10.0",
    "lucide-react": "^0.474.0",
    "motion": "^13.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^0.1.16",
    "@cloudflare/workers-types": "^4.20250121.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wrangler": "^3.109.1"
  }
}
