{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandstone-internal-portal",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Send every request (including the app shell) through the Worker so the
    // Cloudflare Access check in worker/auth.ts covers it.
    "run_worker_first": true
  },
  // Cloudflare Access settings, read by worker/auth.ts. The team domain and
  // AUD tag identify the Access application protecting this Worker's
  // workers.dev route; if either is emptied, the Worker refuses every request.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "ancient-lab-a32a.cloudflareaccess.com",
    "ACCESS_AUD": "5d96eb61a7ebae9d9a0289e7dc900bb166b8b8e97eec150722ab909708a1da03",
    "ALLOWED_EMAILS": "william@sandstonesecurity.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sandstone-internal-portal",
      "database_id": "34e5a577-2099-4a83-a3b7-bc14e1097684",
      "migrations_dir": "migrations"
    }
  ]
}
